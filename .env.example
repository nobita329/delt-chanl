# ==========================================
# Discord Application Credentials
# Obtain these from: https://discord.com/developers/applications
# ==========================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_application_client_id
CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/callback

# (Optional: for instant guild-scoped slash command deployment)
GUILD_ID=

# ==========================================
# Web Panel & API Configuration
# ==========================================
PORT=5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
SESSION_SECRET=super_secret_session_key_change_me_in_production_123456
NODE_ENV=development

# ==========================================
# Database Configuration (SQLite)
# ==========================================
DATABASE_URL="file:./dev.db"

